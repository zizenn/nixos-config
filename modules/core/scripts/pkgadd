#!/usr/bin/env fish

set CONFIG_PATH $HOME/nixos
set PERSONAL_DIR $CONFIG_PATH/modules/_personal
set PKG_LIST /tmp/nix_packages_list.txt
set CATEGORIZE_SCRIPT $CONFIG_PATH/modules/core/scripts/categorize-package.py

if not test -f $PKG_LIST
    echo "Building index (this will take a moment)..."
    nix-env -f '<nixpkgs>' -qaP --json 2>/dev/null | jq -r 'keys[]' > $PKG_LIST
end

set SELECTED_PKG (cat $PKG_LIST | fzf \
    --preview 'set CLEAN (echo {} | cut -d. -f2); nix eval --raw nixpkgs#$CLEAN.meta.description 2>/dev/null; or echo "No description"' \
    --preview-window=right:60% \
    --height=80% \
    --header='Search nixpkgs (ESC to cancel)')

if test -z "$SELECTED_PKG"
    echo "Aborted."
    exit 0
end

set CLEAN_PKG (echo $SELECTED_PKG | cut -d. -f2)

# Check if already exists in any _personal file
set FOUND_FILE (rg -l "^\s+$CLEAN_PKG\b" $PERSONAL_DIR/*.nix 2>/dev/null | head -1)
if test -n "$FOUND_FILE"
    echo "$CLEAN_PKG already in (basename $FOUND_FILE)"
    exit 0
end

# Use LLM to categorize the package
set CATEGORY (python3 $CATEGORIZE_SCRIPT "$CLEAN_PKG" $PERSONAL_DIR)

if test -z "$CATEGORY"
    echo "Failed to categorize package"
    exit 1
end

# Determine target file
set TARGET_FILE $PERSONAL_DIR/$CATEGORY.nix
if not test -f $TARGET_FILE
    echo "Creating new file: $TARGET_FILE"
    echo '{ ... }: {' > $TARGET_FILE
    echo '  homeManager.modules.base = { pkgs, ... }: {' >> $TARGET_FILE
    echo '    home.packages = with pkgs; [' >> $TARGET_FILE
    echo '    ];' >> $TARGET_FILE
    echo '  };' >> $TARGET_FILE
    echo '}' >> $TARGET_FILE
end

# Add package to the appropriate section in the file
python3 $CONFIG_PATH/modules/core/scripts/add-package.py "$CLEAN_PKG" "$TARGET_FILE"

cd $CONFIG_PATH
git add $TARGET_FILE
git commit -m "feat: add $CLEAN_PKG to $CATEGORY" >/dev/null 2>&1

nh home switch