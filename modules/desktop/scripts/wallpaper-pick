set WALLPAPER_DIR "$HOME/nixos/modules/_personal/wallpapers"
set WALLPAPER_LINK "$HOME/.wallpaper"

mkdir -p $WALLPAPER_DIR
cd $WALLPAPER_DIR

set -gx WALLPAPER_DIR $WALLPAPER_DIR

set SELECTED (find . -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%f\n' | sort \
  | fzf --reverse \
      --preview='chafa --symbols=block --size=$FZF_PREVIEW_COLUMNS"x"$FZF_PREVIEW_LINES "$WALLPAPER_DIR"/{} 2>/dev/null' \
      --preview-window='right:60%' \
      --header='Select wallpaper (ESC to cancel)' \
      --height=100%)

if test -z "$SELECTED"
    exit 0
end

set SELECTED_PATH "$WALLPAPER_DIR/$SELECTED"

ln -sf (realpath $SELECTED_PATH) $WALLPAPER_LINK
awww img $WALLPAPER_LINK
or notify-send "wallpaper" "awww failed"
matugen image (realpath $WALLPAPER_LINK) -q --source-color-index 0
or notify-send "wallpaper" "matugen failed"
notify-send -i $SELECTED_PATH "wallpaper" "Set to $SELECTED"
pkill waybar
waybar & disown
exit
