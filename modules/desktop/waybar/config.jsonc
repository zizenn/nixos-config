{
  "exclusive": true,
  "position": "left",
  "passthrough": false,
  "margin-left": 6,
  "width": 44,
  "modules-left": [
    "clock",
    "niri/workspaces"
  ],
  "modules-right": [
    "battery",
    "backlight",
    "pulseaudio",
    "network",
    "custom/bluetooth",
    "custom/separator",
    "tray",
    "custom/power"
  ],
  "niri/workspaces": {
    "all-outputs": true,
    "format": "{value}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "custom/separator": {
    "format": "─",
    "tooltip": false
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wleave",
    "tooltip": false
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": ["󰛨"],
    "on-scroll-down": "brightnessctl s 5%-",
    "on-scroll-up": "brightnessctl s +5%"
  },
  "clock": {
    "format": "<span color='#df6124'>{0:%H}\n{0:%M}</span>",
    "tooltip-format": "{:%a %b %d}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<b>{}</b>",
        "weekdays": "<b>{}</b>",
        "today": "<b>{}</b>"
      }
    }
  },
  "network": {
    "format": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "interval": 3,
    "on-click": "waybar-wifi"
  },
  "battery": {
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": [""],
      "default": [""]
    },
    "format-full": "",
    "tooltip-format": "{capacity}% {power:>1.0f}W",
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "custom/bluetooth": {
    "exec": "waybar-bt",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "connected": ""
    },
    "on-click": "kitty --class bluetui-float -e bluetui",
    "tooltip": true
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "kitty --class wiremix-float -e wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "{volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    }
  },
  "tray": {
    "icon-size": 14,
    "spacing": 4
  }
}
