set CONFIG_PATH $HOME/nixos
set CONFIG_FILE $CONFIG_PATH/packages.nix

set CURRENT_PKGS (sed -n '/^[[:space:]]*home\.packages = with pkgs; \[/,/^\];/{
    /^[[:space:]]*home\.packages/d
    /^\];/d
    /^[[:space:]]*#/d
    /^[[:space:]]*$/d
    s/^[[:space:]]*//
    s/[[:space:]]*$//
    p
}' $CONFIG_FILE)

set SELECTED_PKG (printf '%s\n' $CURRENT_PKGS | fzf \
    --height=80% \
    --reverse \
    --header='Select package to remove')

if test -z "$SELECTED_PKG"
    echo "Aborted."
    exit 0
end

set PKG_PATTERN (echo $SELECTED_PKG | sed 's/\./\\\./g')
set LINE_NUM (rg -n "^\s+$PKG_PATTERN(\s+#.*)?\s*\$" $CONFIG_FILE | head -1 | cut -d: -f1)

if test -z "$LINE_NUM"
    echo "Could not find $SELECTED_PKG in $CONFIG_FILE"
    exit 1
end

sed -i "$LINE_NUM d" $CONFIG_FILE

cd $CONFIG_PATH
git add packages.nix
git commit -m "feat: remove $SELECTED_PKG" >/dev/null 2>&1

nh home switch
