CXX = clang++
CC  = clang

CXXFLAGS = -std=c++20 -O2 -Wall -Wextra
LDFLAGS  =

SRCS = $(wildcard src/*.cpp)
OBJS = $(SRCS:.cpp=.o)
TARGET = app

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(TARGET)

# Usage:
#   make -j$(nproc)
#   make -j$(nproc) clean all
